---
const currentPath = Astro.url?.pathname ?? '/';
const isPersonalPage = currentPath === '/personal' || currentPath.startsWith('/personal/');
const navCtaLabel = isPersonalPage ? 'Professional' : 'Personal';
const navCtaHref = isPersonalPage ? '/professional' : '/personal';
---
<header class="navbar">
  <div class="container nav-container">
    <a href="/" class="logo" aria-label="Nikhil Parag, homepage">
      <img src="/favicon.svg" alt="" width="24" height="24">
      <div class="logo-content">
        <span>Nikhil Parag</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav">
      {isPersonalPage ? (
        <a
          href={navCtaHref}
          class:list={['personal-link', isPersonalPage ? 'nav-active' : '']}
        >
          {navCtaLabel}
        </a>
      ) : (
        <>
          <a href="/professional#profile">Profile</a>
          <a href="/professional#experience">Experience</a>
          <a href="/professional#projects">Projects</a>
          <a href="/professional#education">Education</a>
          <a href="/professional#contact">Contact</a>
          <a
            href={navCtaHref}
            class:list={['personal-link', isPersonalPage ? 'nav-active' : '']}
          >
            {navCtaLabel}
          </a>
        </>
      )}
    </nav>

    <!-- Mobile Menu Button -->
    <button
      id="menuToggle"
      class="menu-toggle"
      aria-label="Open menu">
      ☰
    </button>
  </div>
</header>
