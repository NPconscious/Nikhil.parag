  <script>
    function setupNavigation() {
      const navLinks = document.querySelectorAll('.panel-link');
      const sectionIds = ['hero', 'mission', 'work', 'experience', 'education', 'contact'];
      const sections = sectionIds
        .map((id) => document.getElementById(id))
        .filter((el) => el !== null);

      let currentActiveId = '';

      function setActive(id) {
        if (currentActiveId === id) return;
        currentActiveId = id;
        navLinks.forEach((link) => {
          const targetSection = link.getAttribute('data-section');
          if (targetSection === id) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }

      // Intersection Observer for scrollspy
      const observer = new IntersectionObserver(
        (entries) => {
          const visibleEntries = entries.filter((e) => e.isIntersecting);
          if (visibleEntries.length > 0) {
            const topEntry = visibleEntries.reduce((prev, curr) =>
              curr.intersectionRatio > prev.intersectionRatio ? curr : prev
            );
            setActive(topEntry.target.id);
          }
        },
        {
          rootMargin: '-15% 0px -65% 0px',
          threshold: [0, 0.2, 0.5, 0.8],
        }
      );

      sections.forEach((sec) => observer.observe(sec));

      // Smooth scroll on link click
      navLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
          const targetId = link.getAttribute('data-section');
          if (!targetId) return;
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            e.preventDefault();
            targetEl.scrollIntoView({ behavior: 'smooth' });
            history.pushState(null, '', '#' + targetId);
            setActive(targetId);
            closeMobileNav();
          }
        });
      });

      // Mobile nav drawer open / close
      const toggleBtn = document.getElementById('mobile-nav-toggle');
      const toggleText = document.getElementById('mobile-toggle-text');
      const toggleIcon = document.getElementById('mobile-toggle-icon');
      const panel = document.getElementById('left-panel');
      const backdrop = document.getElementById('nav-backdrop');

      function openMobileNav() {
        panel?.classList.add('is-open');
        backdrop?.classList.add('is-open');
        toggleBtn?.setAttribute('aria-expanded', 'true');
        if (toggleText) toggleText.textContent = 'Close';
        if (toggleIcon) toggleIcon.textContent = '✕';
      }

      function closeMobileNav() {
        panel?.classList.remove('is-open');
        backdrop?.classList.remove('is-open');
        toggleBtn?.setAttribute('aria-expanded', 'false');
        if (toggleText) toggleText.textContent = 'Menu';
        if (toggleIcon) toggleIcon.textContent = '☰';
      }

      toggleBtn?.addEventListener('click', () => {
        const isOpen = panel?.classList.contains('is-open');
        if (isOpen) {
          closeMobileNav();
        } else {
          openMobileNav();
        }
      });

      backdrop?.addEventListener('click', closeMobileNav);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupNavigation);
    } else {
      setupNavigation();
    }
    document.addEventListener('astro:after-swap', setupNavigation);
  </script>
