---
import TasteLayout from "../layouts/TasteLayout.astro";
---

<TasteLayout
  title="About Nikhil Parag | Professional and Lorekeeper"
  description="Choose between Nikhil Parag's professional portfolio and his personal world of stories and ideas."
>
  <header class="nav nav--centre">
    <div class="wrap nav__bar">
      <a class="skip-link" href="#top">Skip to content</a>
      <a class="nav__logo" href="/" aria-label="Nikhil Parag, homepage">
        <img src="/favicon.svg" alt="" width="24" height="24" />Nikhil Parag
      </a>
      <nav class="nav__links" aria-label="About navigation">
        <div class="nav__item"><a class="nav__link" href="/professional#top">Professional</a></div>
        <div class="nav__item"><a class="nav__link" href="/personal">Lorekeeper</a></div>
      </nav>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Open navigation menu">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </div>
  </header>

  <main id="top" class="about-hub">
    <section class="about-split" aria-label="Choose which side of Nikhil Parag to explore">
      <a class="about-panel about-panel--professional" href="/professional#top">
        <img class="about-panel__image" src="/portrait-professional.png" alt="Nikhil Parag smiling in a dark polo shirt" fetchpriority="high" />
        <span class="about-panel__shade" aria-hidden="true"></span>
        <span class="about-panel__content">
          <span class="about-panel__eyebrow">The work</span>
          <h1>Professional</h1>
          <span class="about-panel__description">Career experience, projects, research and credentials.</span>
          <span class="about-panel__action">Explore the portfolio <span aria-hidden="true">↗</span></span>
        </span>
      </a>
      <a class="about-panel about-panel--lorekeeper" href="/personal">
        <img class="about-panel__image" src="/portrait-lorekeeper.png" alt="Cartoon illustration of Nikhil Parag with orange brushstrokes" />
        <span class="about-panel__shade" aria-hidden="true"></span>
        <span class="about-panel__content">
          <span class="about-panel__eyebrow">Away from work</span>
          <h2>Lorekeeper</h2>
          <span class="about-panel__description">Stories, games, worlds and the questions that keep me curious.</span>
          <span class="about-panel__action">Enter the story <span aria-hidden="true">↗</span></span>
        </span>
      </a>
      <div class="about-split__caption" aria-hidden="true">Nikhil Parag <span>·</span> two sides, one curious mind</div>
    </section>
  </main>

  <style is:global>
    html[data-type="service"] body { color-scheme: light; background: var(--p-bg); color: var(--p-ink); font-family: var(--font-text); }
    html[data-type="service"] body::before { display: none; }
    html[data-type="service"] main { width: 100%; max-width: none; margin: 0; overflow: visible; }
    html[data-type="service"] .about-split {
      position: relative; display: flex; min-height: calc(100svh - 80px); overflow: hidden;
      background: #e8e8e3; isolation: isolate;
    }
    html[data-type="service"] .about-panel {
      position: relative; display: block; flex: 1 1 0; min-width: 0; min-height: calc(100svh - 80px);
      overflow: hidden; color: #fff; text-decoration: none; isolation: isolate;
      transition: flex-grow .65s cubic-bezier(.2,.75,.2,1);
    }
    html[data-type="service"] .about-panel__image,
    html[data-type="service"] .about-panel__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
    html[data-type="service"] .about-panel__image { z-index: -2; display: block; object-fit: cover; object-position: center 28%; transition: transform .8s cubic-bezier(.2,.75,.2,1); }
    html[data-type="service"] .about-panel--professional .about-panel__image { object-position: center 22%; }
    html[data-type="service"] .about-panel--professional .about-panel__image { scale: 1.14; }
    html[data-type="service"] .about-panel__shade { z-index: -1; background: linear-gradient(180deg,rgba(15,14,13,.03) 25%,rgba(15,14,13,.25) 54%,rgba(15,14,13,.82) 100%); }
    html[data-type="service"] .about-panel--lorekeeper .about-panel__shade { background: linear-gradient(180deg,rgba(34,19,9,.02) 22%,rgba(40,22,9,.22) 52%,rgba(28,17,12,.82) 100%); }
    html[data-type="service"] .about-panel__content { position: absolute; inset: auto 0 0; display: flex; flex-direction: column; align-items: flex-start; padding: clamp(32px,6vw,88px); }
    html[data-type="service"] .about-panel__eyebrow { font-size: var(--t-small); letter-spacing: .12em; text-transform: uppercase; }
    html[data-type="service"] .about-panel h1,
    html[data-type="service"] .about-panel h2 { margin: 12px 0 14px; color: #fff; font: 400 clamp(44px,7vw,96px)/.96 var(--font-display); letter-spacing: var(--display-tracking-xl); }
    html[data-type="service"] .about-panel__description { max-width: 38ch; font-size: clamp(15px,1.35vw,19px); line-height: 1.5; }
    html[data-type="service"] .about-panel__action { display: flex; width: 100%; max-width: 370px; justify-content: space-between; gap: 20px; margin-top: 28px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.55); font-size: var(--t-small); }
    html[data-type="service"] .about-panel__action span { font-size: 20px; transition: transform .2s ease; }
    html[data-type="service"] .about-panel:hover .about-panel__image,
    html[data-type="service"] .about-panel:focus-visible .about-panel__image { transform: scale(1.035); }
    html[data-type="service"] .about-panel:hover .about-panel__action span,
    html[data-type="service"] .about-panel:focus-visible .about-panel__action span { transform: translate(3px,-3px); }
    html[data-type="service"] .about-split:has(.about-panel--professional:hover) .about-panel--professional,
    html[data-type="service"] .about-split:has(.about-panel--professional:focus-visible) .about-panel--professional { flex-grow: 1.55; }
    html[data-type="service"] .about-split:has(.about-panel--professional:hover) .about-panel--lorekeeper,
    html[data-type="service"] .about-split:has(.about-panel--professional:focus-visible) .about-panel--lorekeeper { flex-grow: .72; }
    html[data-type="service"] .about-split:has(.about-panel--lorekeeper:hover) .about-panel--lorekeeper,
    html[data-type="service"] .about-split:has(.about-panel--lorekeeper:focus-visible) .about-panel--lorekeeper { flex-grow: 1.55; }
    html[data-type="service"] .about-split:has(.about-panel--lorekeeper:hover) .about-panel--professional,
    html[data-type="service"] .about-split:has(.about-panel--lorekeeper:focus-visible) .about-panel--professional { flex-grow: .72; }
    html[data-type="service"] .about-panel:focus-visible { outline: 3px solid #fff; outline-offset: -8px; }
    html[data-type="service"] .about-split__caption { position: absolute; z-index: 3; top: 24px; left: 50%; translate: -50% 0; padding: 10px 15px; border: 1px solid rgba(255,255,255,.55); border-radius: 999px; background: rgba(24,23,21,.38); color: #fff; font-size: 12px; white-space: nowrap; backdrop-filter: blur(10px); }
    html[data-type="service"] .about-split__caption span { padding-inline: 5px; color: #f0b17a; }
    @media (max-width: 767px) {
      html[data-type="service"] .about-split { display: block; min-height: 0; overflow: visible; }
      html[data-type="service"] .about-panel { min-height: 68svh; }
      html[data-type="service"] .about-panel__content { padding: 32px 26px; }
      html[data-type="service"] .about-panel h1,
      html[data-type="service"] .about-panel h2 { font-size: clamp(44px,12vw,64px); }
      html[data-type="service"] .about-panel--professional .about-panel__image { object-position: center 18%; }
      html[data-type="service"] .about-panel--lorekeeper .about-panel__image { object-position: center 24%; }
      html[data-type="service"] .about-split__caption { position: absolute; top: 16px; font-size: 11px; }
    }
    @media (prefers-reduced-motion: reduce) {
      html[data-type="service"] .about-panel, html[data-type="service"] .about-panel__image,
      html[data-type="service"] .about-panel__action span { transition: none; }
    }
  </style>
</TasteLayout>
