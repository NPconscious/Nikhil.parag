---
import TasteLayout from "../layouts/TasteLayout.astro";
---

<TasteLayout
  title="Nikhil Parag | Founder of NPconscious"
  description="Information Science graduate with experience in international operations, customer success, and global sales."
  themeColor="#141512"
>
  <!-- Service portfolio. Editorial paper palette, split portrait hero, centred navigation, ruled career and education lists, open project grid, and one word-highlight statement moment. -->
  <header class="nav nav--centre">
    <div class="wrap nav__bar">
      <a class="skip-link" href="#top">Skip to content</a>
      <a class="nav__logo" href="/" aria-label="Nikhil Parag, homepage">
        <img src="/favicon.svg" alt="" width="24" height="24" />Nikhil Parag
      </a>
      <nav class="nav__links" aria-label="Main navigation">
        <div class="nav__item"><a class="nav__link" href="#experience">Experience</a></div>
        <div class="nav__item"><a class="nav__link" href="#education">Education</a></div>
        <div class="nav__item"><a class="nav__link" href="#projects">Projects</a></div>
        <div class="nav__item"><a class="nav__link" href="/personal">Personal</a></div>
        <div class="nav__item"><a class="nav__link" href="#contact">Contact</a></div>
      </nav>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Open navigation menu">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </div>
  </header>

  <main id="top">
    <section class="hero hero--split" data-enter aria-labelledby="hero-h">
      <div class="wrap">
        <div class="hero-text grid hero__grid">
          <div class="hero__text span-6">
            <p class="hero__kicker">Founder of NPconscious</p>
            <h1 id="hero-h">Nikhil Parag</h1>
            <p class="hero__lead">
              Information Science graduate with experience in international operations, customer success, and global sales.
            </p>
            <div class="btn-row">
              <a class="btn btn--primary" href="mailto:nikhilparag0@gmail.com">
                Email Nikhil
                <svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8" /><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5" /></svg>
              </a>
              <a class="btn btn--secondary" href="#projects">See selected projects</a>
            </div>
          </div>
          <div class="hero__media span-6 start-7">
            <img src="/profile-professional.png" alt="Nikhil Parag smiling in a dark polo shirt" fetchpriority="high" data-source="client" data-subject="Nikhil Parag" />
            <div class="ly-float" aria-label="Career experience">
              <p class="portfolio-fact">5,000+</p>
              <p class="ly-float__title">Clients handled across roles</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section statement-section" id="profile" aria-labelledby="profile-h" data-moment="word-highlight">
      <div class="wrap">
        <div class="section-head">
          <h2 id="profile-h">What Drives Me</h2>
        </div>
        <p class="mo-wh__text">
          I want education to build independent thinkers. Through technology, mentorship and practical problem solving, I create learning experiences with value beyond the classroom.
        </p>
      </div>
    </section>

    <section class="section g2m career-education-section" id="experience" aria-labelledby="experience-h" style="--hm: 2">
      <div class="wrap">
        <div class="group career-group">
          <div class="section-head">
            <h2 id="experience-h">Work across operations, sales and counselling</h2>
            <p>Experience with Concentrix and Airbnb, Bhanzu, and USDC Global.</p>
          </div>
          <ul class="career-list">
            <li>
              <h3>Concentrix / Airbnb</h3>
              <p>Customer operations</p>
            </li>
            <li>
              <h3>Bhanzu</h3>
              <p>International sales across the US and UK</p>
            </li>
            <li>
              <h3>USDC Global</h3>
              <p>Study abroad counselling</p>
            </li>
          </ul>
        </div>
        <div class="group education-group" id="education" aria-labelledby="education-h">
          <div class="section-head">
            <h2 id="education-h">Education and credentials</h2>
          </div>
          <ul class="education-list">
            <li><span class="education-list__type">Degree</span><span class="education-list__name">B.E. Information Science</span></li>
            <li><span class="education-list__type">Certification</span><a class="education-list__name link" href="https://www.credly.com/badges/7ab00e03-af5a-4a03-99c9-7e264e02423e/public_url" target="_blank" rel="noopener noreferrer">Microsoft Azure Fundamentals</a></li>
            <li><span class="education-list__type">Certification</span><a class="education-list__name link" href="https://www.credly.com/badges/861459a8-0b58-475a-8dbd-97450101926a/public_url" target="_blank" rel="noopener noreferrer">Microsoft Power Platform Fundamentals</a></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section projects-section" id="projects" aria-labelledby="projects-h" style="--hm: 2">
      <div class="wrap">
        <div class="section-head">
          <h2 id="projects-h">Research and ventures</h2>
          <p>Work across applied machine learning, mathematics education, and reader communities.</p>
        </div>
        <div class="project-cards">
          <article class="project-card">
            <div class="project-card__top"><span>Published research</span></div>
            <h3><a href="https://www.ijcrt.org/author_details.php?name=Nikhil%20Parag&slot=3" target="_blank" rel="noopener noreferrer">Signature forgery detection <span aria-hidden="true">↗</span></a></h3>
            <p>One-shot learning research exploring how machine learning can distinguish genuine signatures from forgeries.</p>
            <span class="project-card__foot">International Journal of Creative Research Thoughts</span>
          </article>
          <article class="project-card">
            <div class="project-card__top"><span>Education technology</span></div>
            <h3><a href="https://npconscious.com" target="_blank" rel="noopener noreferrer">NPconscious <span aria-hidden="true">↗</span></a></h3>
            <p>A curiosity-first mathematics learning initiative for school and engineering students.</p>
            <span class="project-card__foot">Mathematics · Mentorship</span>
          </article>
          <article class="project-card">
            <div class="project-card__top"><span>Reader community</span></div>
            <h3><a href="https://mangaanimewebtoon.com" target="_blank" rel="noopener noreferrer">Manga Anime Webtoon <span aria-hidden="true">↗</span></a></h3>
            <p>A place for readers to find reviews, news and webnovels across anime, manga and webtoons.</p>
            <span class="project-card__foot">Reviews · News · Webnovels</span>
          </article>
        </div>
      </div>
    </section>

  </main>

  <footer class="footer closing" id="contact">
    <div class="wrap">
      <div class="footer-main">
        <div class="footer-sites-column">
          <div class="footer-sites">
            <span>My Sites</span>
            <div class="footer-site-list">
              <a class="footer-site-card" href="https://nikhilparag.com/" target="_blank" rel="noopener noreferrer"><img src="/favicon.svg" alt="" width="48" height="48" loading="lazy" /><span>Nikhil Parag</span></a>
              <a class="footer-site-card" href="https://mangaanimewebtoon.com/" target="_blank" rel="noopener noreferrer"><img src="/mangaanimewebtoon-site-logo.ico" alt="" width="48" height="48" loading="lazy" /><span>Manga Anime Webtoon</span></a>
              <a class="footer-site-card" href="https://npconscious.com/" target="_blank" rel="noopener noreferrer"><img src="/npconscious-footer-mark.png" alt="" width="48" height="48" loading="lazy" /><span>NPconscious.com</span></a>
            </div>
          </div>
        </div>
        <section class="footer-say-hi" aria-labelledby="footer-say-hi-title">
          <h2 id="footer-say-hi-title">Say Hi at <a class="footer-contact__email" href="mailto:nikhilparag@npconscious.com">nikhilparag@npconscious.com</a></h2>
          <nav class="footer-contact" aria-label="Contact Nikhil">
            <a class="footer-contact__whatsapp" href="https://wa.me/918088276492" target="_blank" rel="noopener noreferrer"><img class="footer-contact__icon" src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/whatsapp.svg" alt="" width="20" height="20" />WhatsApp</a>
            <a href="tel:+918088276492"><svg class="footer-contact__icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h3l2 5-2.2 1.8a15 15 0 0 0 6.4 6.4L16 14l5 2v3c0 1.1-.9 2-2 2C10 21 3 14 3 5c0-1.1.9-2 2-2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>Call 8088276492</a>
            <a href="https://www.instagram.com/nikhil_lord_of_edo/" target="_blank" rel="noopener noreferrer"><img class="footer-contact__icon footer-contact__icon--light" src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/instagram.svg" alt="" width="20" height="20" />Instagram</a>
          </nav>
        </section>
      </div>
      <div class="footer__legal"><span>&copy; {new Date().getFullYear()} Nikhil Parag</span></div>
    </div>
  </footer>

  <style is:global>
    html[data-type="service"] {
      color-scheme: dark;
      --p-bg: #141512;
      --p-surface: #20221e;
      --p-ink: #f1f0e9;
      --p-muted: #c0c1b8;
      --p-accent: #d1c44b;
      --p-accent-ink: #171811;
      --p-action: #d1c44b;
      --p-action-ink: #171811;
      --p-inv-bg: #ecebe4;
      --p-inv-surface: #f6f5ef;
      --p-inv-ink: #171811;
      --p-inv-muted: #575950;
      --p-inv-accent: #a99d25;
      --p-inv-accent-ink: #171811;
      --p-inv-action: #171811;
      --p-inv-action-ink: #ecebe4;
    }

    html[data-type="service"] body {
      color-scheme: dark;
      background: var(--p-bg);
      color: var(--p-ink);
      font-family: var(--font-text);
    }

    html[data-type="service"] body::before { display: none; }
    html[data-type="service"] main { width: 100%; max-width: none; margin: 0; overflow: visible; }
    html[data-type="service"] .nav__logo > img { border-radius: 5px; outline: 1px solid var(--line-strong); }
    html[data-type="service"] .portfolio-fact {
      margin: 0;
      font: var(--display-weight) var(--t-stat)/1 var(--font-display);
      letter-spacing: var(--display-tracking);
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }
    html[data-type="service"] .ly-float { width: min(300px, calc(100% - 48px)); }
    html[data-type="service"] .hero__media > img { object-position: center 28%; }
    html[data-type="service"] .statement-section .section-head { margin-bottom: 24px; }
    html[data-type="service"] .mo-wh__text {
      max-width: 1000px;
      margin: 0;
      font: var(--display-weight) clamp(28px, 3.1vw, 40px)/1.18 var(--font-display);
      letter-spacing: var(--display-tracking);
      text-wrap: pretty;
    }
    html[data-type="service"] .career-education-section { --h: 1; }
    html[data-type="service"] .career-education-section > .wrap { display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); align-content: start; gap: var(--gutter); }
    html[data-type="service"] .career-group { grid-column: 1 / span 7; }
    html[data-type="service"] .education-group { grid-column: 8 / span 5; }
    html[data-type="service"] .career-group,
    html[data-type="service"] .education-group { min-width: 0; }
    html[data-type="service"] .career-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
    html[data-type="service"] .career-list li { min-width: 0; display: grid; align-content: start; gap: var(--s-3); padding-top: var(--s-4); border-top: 1px solid var(--line); }
    html[data-type="service"] .career-list h3 { margin: 0; font: 400 clamp(23px,2.2vw,30px)/1.15 var(--font-display); letter-spacing: var(--display-tracking); overflow-wrap: anywhere; }
    html[data-type="service"] .career-list p { margin: 0; color: var(--p-muted); line-height: 1.5; }
    html[data-type="service"] .projects-section { --h: 1; }
    html[data-type="service"] .project-cards { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: var(--gutter); }
    html[data-type="service"] .project-card { box-sizing: border-box; width: 100%; min-width: 0; min-height: 350px; display: flex; flex-direction: column; padding: var(--s-4) 0 0; border-top: 1px solid var(--line); }
    html[data-type="service"] .project-card__top { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); color: var(--p-muted); font-size: var(--t-small); }
    html[data-type="service"] .project-card h3 { min-height: 2.24em; margin: var(--s-5) 0 var(--s-3); font: 400 clamp(23px,2.2vw,30px)/1.12 var(--font-display); letter-spacing: var(--display-tracking); overflow-wrap: anywhere; }
    html[data-type="service"] .project-card h3 a { color: var(--p-ink); text-decoration: none; }
    html[data-type="service"] .project-card h3 a:hover { text-decoration: underline; text-underline-offset: 5px; }
    html[data-type="service"] .project-card h3 a span { display: inline-block; font: 400 .65em/1 var(--font-text); transition: transform .2s ease; }
    html[data-type="service"] .project-card h3 a:hover span { transform: translate(3px,-3px); }
    html[data-type="service"] .project-card p { max-width: 42ch; min-height: 4.65em; margin: 0 0 var(--s-5); color: var(--p-muted); line-height: 1.55; }
    html[data-type="service"] .project-card__foot { margin-top: auto; color: var(--p-muted); font-size: var(--t-small); }
    html[data-type="service"] .education-list { display: grid; grid-template-columns: 1fr; gap: var(--s-4); margin: 0; padding: 0; list-style: none; }
    html[data-type="service"] .education-list li { min-width: 0; display: grid; align-content: start; gap: var(--s-5); padding-top: var(--s-4); border-top: 1px solid var(--line); }
    html[data-type="service"] .education-list__type { color: var(--p-muted); font-size: var(--t-small); }
    html[data-type="service"] .education-list__name { font-size: var(--t-lead); line-height: 1.4; }
    html[data-type="service"] .education-list a { color: var(--p-ink); }
    html[data-type="service"] .footer-brand { grid-column: span 4; }
    html[data-type="service"] .footer__col h3 {
      margin: 0 0 12px;
      font: 500 var(--t-body)/1.4 var(--font-text);
    }
    html[data-type="service"] .footer__col ul { list-style: none; padding: 0; margin: 0; }
    html[data-type="service"] .footer__col li { margin: 0; }
    html[data-type="service"] .footer__col a { font-size: var(--t-small); }
    html[data-type="service"] .footer-contact { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: var(--s-6); padding-top: var(--s-5); border-top: 1px solid var(--line); }
    html[data-type="service"] .footer-contact__label { width: 100%; color: var(--p-muted); font-size: var(--t-small); }
    html[data-type="service"] .footer-contact a { display: inline-flex; align-items: center; min-height: 44px; padding: 9px 14px; border: 1px solid color-mix(in oklab,var(--p-ink) 24%,transparent); border-radius: 999px; color: var(--p-ink); font-size: var(--t-small); text-decoration: none; overflow-wrap: anywhere; }
    html[data-type="service"] .footer-contact .footer-contact__whatsapp { gap: 8px; border-color: #25d366; background: #25d366; color: #102b19; }
    html[data-type="service"] .footer-contact__whatsapp img { flex: none; width: 20px; height: 20px; }
    html[data-type="service"] .footer__legal { border-top: 1px solid var(--line); }
    @media (max-width: 1023px) {
      html[data-type="service"] .career-education-section { --h: 2; }
      html[data-type="service"] .career-education-section > .wrap { grid-template-columns: 1fr; grid-template-rows: minmax(0,1fr) minmax(0,1fr); row-gap: calc(var(--padt) + var(--padb)); }
      html[data-type="service"] .career-group,
      html[data-type="service"] .education-group { grid-column: auto; }
      html[data-type="service"] .footer__col { grid-column: span 6; }
      html[data-type="service"] .footer-brand { grid-column: 1 / -1; }
      html[data-type="service"] .career-list,
      html[data-type="service"] .project-cards { grid-template-columns: repeat(2,minmax(0,1fr)); }
      html[data-type="service"] .project-card { min-height: 0; }
      html[data-type="service"] .education-list { grid-template-columns: repeat(3,minmax(0,1fr)); }
    }
    @media (max-width: 639px) {
      html[data-type="service"] .statement-section { height: auto; min-height: 100svh; display: block; padding-block: var(--s-8); margin-block-start: 0; }
      html[data-type="service"] .nav__actions .btn { padding-inline: 10px; }
      html[data-type="service"] .wrap,
      html[data-type="service"] .section,
      html[data-type="service"] .career-education-section,
      html[data-type="service"] .projects-section { min-width: 0; max-width: 100%; }
      html[data-type="service"] .career-list,
      html[data-type="service"] .project-cards,
      html[data-type="service"] .education-list { grid-template-columns: 1fr; gap: var(--s-5); }
      html[data-type="service"] .project-cards { grid-template-columns: 1fr; }
      html[data-type="service"] .project-card h3,
      html[data-type="service"] .project-card p { min-height: 0; }
    }
    html[data-type="service"] footer.closing { height: auto; min-height: 0; padding: clamp(28px, 4vw, 56px) 0; border-top: 0; }
    html[data-type="service"] footer.closing > .wrap { height: auto; }
    html[data-type="service"] .footer-main { display: grid; grid-template-columns: minmax(220px, .75fr) minmax(0, 1.25fr); gap: clamp(32px, 7vw, 100px); align-items: start; }
    html[data-type="service"] .footer-main > .footer-brand { grid-column: auto; }
    html[data-type="service"] .footer-say-hi h2 { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: .22em; row-gap: 0; margin: 0 0 20px; font: 400 clamp(32px, 4vw, 48px)/1.05 var(--font-display); letter-spacing: var(--display-tracking); }
    html[data-type="service"] .footer-contact { display: flex; flex-direction: column; align-items: stretch; gap: 0; width: 100%; margin: 0; padding: 0; border: 0; }
    html[data-type="service"] .footer-contact a { display: inline-flex; justify-self: auto; width: 100%; max-width: 100%; align-items: center; justify-content: flex-start; gap: 12px; min-height: 64px; min-width: 0; padding: 18px 0; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; color: var(--p-ink); font-size: var(--t-small); line-height: 1.4; text-decoration: none; white-space: nowrap; transition: color .18s ease; }
    html[data-type="service"] .footer-contact a:hover { color: var(--p-accent); }
    html[data-type="service"] .footer-contact__icon { flex: none; width: 22px !important; height: 22px !important; object-fit: contain; }
    html[data-type="service"] .footer-contact__icon--light { filter: brightness(0) saturate(100%) invert(44%) sepia(78%) saturate(2450%) hue-rotate(314deg) brightness(102%) contrast(101%) !important; }
    html[data-type="service"] .footer-contact .footer-contact__whatsapp { border-color: transparent; border-bottom-color: var(--line); background: transparent; color: var(--p-ink); }
    html[data-type="service"] .footer-say-hi h2 .footer-contact__email { display: inline-block; width: auto; min-height: 0; padding: 0; border: 0; border-radius: 0; color: #ff5b5b; font: 500 clamp(28px, 3vw, 40px)/.95 "Caveat", cursive; letter-spacing: 0; text-decoration: none; overflow-wrap: anywhere; }
    html[data-type="service"] .footer-contact__whatsapp img { flex: none; width: 22px; height: 22px; filter: brightness(0) saturate(100%) invert(57%) sepia(81%) saturate(451%) hue-rotate(89deg) brightness(94%) contrast(91%); }
    html[data-type="service"] .footer-sites { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 20px; font-size: var(--t-small); }
    html[data-type="service"] .footer-sites { display: block; margin-top: 0; }
    html[data-type="service"] .footer-sites > span { display: block; margin-bottom: 10px; color: var(--p-muted); font-size: 2em; line-height: 1.1; }
    html[data-type="service"] .footer-site-list { display: grid; gap: 0; }
    html[data-type="service"] .footer-site-card { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--p-ink); font-size: var(--t-small); text-decoration: none; transition: color .18s ease; }
    html[data-type="service"] .footer-site-card:hover { color: var(--p-accent); }
    html[data-type="service"] .footer-site-card img { display: block; flex: none; width: 48px; height: 48px; object-fit: contain; }
    html[data-type="service"] .footer__legal { margin-top: 28px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--p-muted); font-size: var(--t-small); }
    @media (max-width: 767px) {
      html[data-type="service"] .footer-main { grid-template-columns: minmax(0, 1fr); gap: 28px; }
      html[data-type="service"] .footer-contact { grid-template-columns: minmax(0, 1fr); }
      html[data-type="service"] .footer-contact a { width: fit-content; max-width: 100%; }
    }
  </style>
</TasteLayout>
