---
interface Props {
  title: string;
  description: string;
  themeColor?: string;
}

const { title, description, themeColor = "#e8e8e3" } = Astro.props;
---

<!doctype html>
<html lang="en" data-type="service" data-radius="soft" data-buttons="tonal" data-motion>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="site-kind" content="other" />
    <meta name="page-type" content="service" />
    <meta name="theme-color" content={themeColor} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/profile.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- <link rel="canonical" href="https://[personal domain]/"> -->
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=Schibsted+Grotesk:wght@400..700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/system.css" />
    <link rel="stylesheet" href="/assets/ui/cards.css" />
    <link rel="stylesheet" href="/assets/motion/motion.css" />
    <link rel="stylesheet" href="/assets/backgrounds/backgrounds.css" />
    <link rel="stylesheet" href="/assets/layout/layout.css" />
    <link rel="stylesheet" href="/assets/icons/icon.css" />
    <link rel="stylesheet" href="/assets/diagrams/diagram.css" />
    <link rel="stylesheet" href="/assets/ui/base.css" />
    <link rel="stylesheet" href="/assets/moments/word-highlight/moment.css" />
    <style is:global>
      :root {
        --p-bg: #e8e8e3; --p-surface: #dcdcd6; --p-ink: #181715; --p-muted: #5c5b56;
        --p-accent: #bfb21a; --p-accent-ink: #181715; --p-action: #181715; --p-action-ink: #e8e8e3;
        --p-inv-bg: #181715; --p-inv-surface: #242321; --p-inv-ink: #e8e8e3; --p-inv-muted: #91908d;
        --p-inv-accent: #bfb21a; --p-inv-accent-ink: #181715; --p-inv-action: #bfb21a; --p-inv-action-ink: #181715;
        --font-display: "Schibsted Grotesk", system-ui, sans-serif;
        --font-text: "Schibsted Grotesk", system-ui, sans-serif;
        --display-weight: 400; --display-tracking: -0.035em; --display-tracking-xl: -0.042em; --ly-scale: 0.98;
      }
    </style>
    <script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
    <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
    <link rel="modulepreload" href="/assets/moments/moments.js" />
    <link rel="modulepreload" href="/assets/moments/lib.js" />
    <link rel="modulepreload" href="/assets/moments/word-highlight/moment.js" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script is:inline type="module" src="/assets/system.js"></script>
    <script is:inline type="module" src="/assets/layout/layout.js"></script>
    <script is:inline type="module" src="/assets/motion/motion.js"></script>
    <script is:inline type="module" src="/assets/moments/moments.js"></script>
    <script is:inline type="module" src="/assets/diagrams/mount.js"></script>
  </body>
</html>
