---
const currentPath = Astro.url?.pathname ?? '/';
const isPersonalPage = currentPath === '/personal' || currentPath.startsWith('/personal/');
const navCtaLabel = isPersonalPage ? 'Professional' : 'Personal';
const navCtaHref = isPersonalPage ? '/' : '/personal';
---
<header class="navbar">
  <div class="container nav-container">
    <a href="/" class="logo">
      <img src="/logo.png" alt="NPconscious Logo">
      <div class="logo-content">
        <span>Nikhil Parag</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav">
      {isPersonalPage ? (
        <a
          href={navCtaHref}
          class:list={['personal-link', isPersonalPage ? 'nav-active' : '']}
        >
          {navCtaLabel}
        </a>
      ) : (
        <>
          <a href="/#mission">Mission</a>
          <a href="/#building">Building</a>
          <a href="/#work">Work</a>
          <a href="/#experience">Experience</a>
          <a href="/#contact">Contact</a>
          <a
            href={navCtaHref}
            class:list={['personal-link', isPersonalPage ? 'nav-active' : '']}
          >
            {navCtaLabel}
          </a>
        </>
      )}
    </nav>

    <!-- Mobile Menu Button -->
    <button
      id="menuToggle"
      class="menu-toggle"
      aria-label="Open menu">
      ☰
    </button>
  </div>
</header>
