---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Personal | Nikhil Parag"
  description="The two sides of Nikhil Parag — Global Operator and Tech Builder."
>
  <main id="personal-main">
    <!-- Split Hero Section -->
    <section id="split-hero">
      <div class="split-hero-bg-wrapper" aria-hidden="true">
        <img
          src="/personal-hero-bg.jpg"
          alt=""
          class="split-hero-bg-img"
          loading="eager"
          decoding="async"
        />
        <div class="split-hero-bg-overlay"></div>
      </div>

      <!-- Left Side: The Lorekeeper -->
      <a
        href="#mangaanimewebtoon"
        class="split-side split-left"
        id="split-left"
      >
        <div class="split-bg split-bg-left"></div>
        <div class="split-overlay split-overlay-left"></div>
        <div class="split-content split-content-left">
          <span class="split-label">The</span>
          <h1 class="split-title">LoreKeeper</h1>
          <p class="split-desc">
            "Not all those who wander are lost."
            <br />
            <span>— J. R. R. Tolkien</span>
          </p>
          <ul class="split-traits">
            <li>🎌 Anime, Manga & Webtoons</li>
            <li>🎮 Video Games & RPGs</li>
            <li>🎲 Tabletop Games & D&D</li>
            <li>🏰 Fantasy & Science Fiction</li>
            <li>📜 Lore & Mythology</li>
          </ul>
        </div>
      </a>

      <!-- Divider + Portrait -->
      <div class="split-center">
        <div class="split-portrait-ring">
          <img src="/profile.jpg" alt="Nikhil Parag" class="split-portrait" />
        </div>
        <div class="split-name-badge">
          <span>Nikhil Parag</span>
        </div>
      </div>

      <!-- Right Side: The Seeker-->
      <a href="/#work" class="split-side split-right" id="split-right">
        <div class="split-bg split-bg-right"></div>
        <div class="split-overlay split-overlay-right"></div>
        <div class="split-content split-content-right">
          <span class="split-label">The</span>
          <h1 class="split-title">Seeker</h1>
          <p class="split-desc">
            "Nothing in life is to be feared, it is only to be understood."
            <br />
            <span>— Marie Curie</span>
          </p>
          <ul class="split-traits">
            <ul class="split-traits">
              <li>🚀 Space Exploration</li>
              <li>🤖 Artificial Intelligence</li>
              <li>📜 History & Civilizations</li>
              <li>🏛️ Constitution & Polity</li>
              <li>🌍 Geography & Geopolitics</li>
              <li>🔬 Science & Discovery</li>
              <li>📈 Economics & Society</li>
              <li>🧠 Psychology & Human Behavior</li>
            </ul>
          </ul>
        </div>
      </a>
    </section>

    <!-- Philosophy Section -->
    <section id="mangaanimewebtoon" class="personal-philosophy">
      <div class="philosophy-inner">
        <span class="section-label">MANGAANIMEWEBTOON.COM</span>
        <h2>The Stories We Love</h2>

        <p class="section-description">
          Exploring anime, manga, webtoons, manhwa, and the worlds that make
          them unforgettable.
        </p>

        <div class="philosophy-grid">
          <a
            href="https://mangaanimewebtoon.com/reviews/"
            target="_blank"
            rel="noopener noreferrer"
            class="philosophy-card philosophy-card-link"
          >
            <div class="philosophy-icon">⭐</div>
            <h3>Reviews</h3>
            <p>
              Honest takes on anime, manga, and webtoons — what's worth your
              time, what's overhyped, and hidden gems you shouldn't miss.
            </p>
            <span class="card-cta">
              Read Reviews <span class="card-cta-arrow">↗</span>
            </span>
          </a>

          <a
            href="https://mangaanimewebtoon.com/news/"
            target="_blank"
            rel="noopener noreferrer"
            class="philosophy-card philosophy-card-link"
          >
            <div class="philosophy-icon">📰</div>
            <h3>News</h3>
            <p>
              Stay up to date with the latest announcements, releases, and
              happenings from the world of anime, manga, and webtoons.
            </p>
            <span class="card-cta">
              Latest News <span class="card-cta-arrow">↗</span>
            </span>
          </a>

          <a
            href="https://mangaanimewebtoon.com/webnovel/"
            target="_blank"
            rel="noopener noreferrer"
            class="philosophy-card philosophy-card-link"
          >
            <div class="philosophy-icon">📚</div>
            <h3>Webnovels</h3>
            <p>
              Vast worlds built word by word — epic fantasy, cultivation,
              isekai, and system stories that keep you reading until dawn.
            </p>
            <span class="card-cta">
              Explore Webnovels <span class="card-cta-arrow">↗</span>
            </span>
          </a>
        </div>

        <a
          href="https://mangaanimewebtoon.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="site-link"
        >
          <span class="site-link-inner">
            <span class="site-link-icon">🌐</span>
            <span class="site-link-text">
              <span class="site-link-label">Visit the full site</span>
              <span class="site-link-domain">mangaanimewebtoon.com</span>
            </span>
            <span class="site-link-arrow">↗</span>
          </span>
        </a>

        <!-- Currently Section -->
        <section class="personal-currently">
          <div class="currently-inner">
            <span class="section-label">RIGHT NOW</span>
            <h2>Currently</h2>
            <div class="currently-grid">
              <div class="currently-item">
                <span class="currently-icon">📖</span>
                <div>
                  <h4>Reading</h4>
                  <p>
                    Lord of the Mysteries, Reverend Insanity, The Beginning
                    After the End, Mother of Learning, and Shadow Slave.
                  </p>
                </div>
              </div>

              <div class="currently-item">
                <span class="currently-icon">🏗️</span>
                <div>
                  <h4>writing</h4>
                  <p>
                    <a href="/the-second-young-master/" class="story-link">
                      The Second Young Master
                    </a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </section>

    <style>
      /* =============================================
         PERSONAL PAGE - SPLIT HERO
      ============================================= */

      #personal-main {
        min-height: 100vh;
      }

      #split-hero {
        position: relative;
        display: flex;
        align-items: stretch;
        height: 100vh;
        min-height: 600px;
        overflow: hidden;
        isolation: isolate;
      }

      /* ---- Split Hero Background Image ---- */
      .split-hero-bg-wrapper {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
      }

      .split-hero-bg-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
        filter: brightness(0.72) contrast(1.1);
        transform: scale(1.02);
      }

      .split-hero-bg-overlay {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.6) 0%,
            rgba(0, 0, 0, 0.2) 30%,
            rgba(0, 0, 0, 0.5) 75%,
            #000000 100%
          ),
          radial-gradient(
            circle at 50% 50%,
            rgba(0, 0, 0, 0.1) 0%,
            rgba(0, 0, 0, 0.6) 80%
          );
        pointer-events: none;
      }

      /* ---- Sides ---- */

      .split-side {
        position: relative;
        flex: 1;
        display: flex;
        align-items: center;
        overflow: hidden;
        cursor: pointer;
        transition: flex 0.6s cubic-bezier(0.77, 0, 0.18, 1);
        text-decoration: none;
        color: inherit;
        z-index: 2;
      }

      #split-hero:has(.split-left:hover) .split-left {
        flex: 1.6;
      }

      #split-hero:has(.split-left:hover) .split-right {
        flex: 0.4;
      }

      #split-hero:has(.split-right:hover) .split-right {
        flex: 1.6;
      }

      #split-hero:has(.split-right:hover) .split-left {
        flex: 0.4;
      }

      /* ---- Backgrounds ---- */

      .split-bg {
        position: absolute;
        inset: 0;
        transition:
          opacity 0.5s ease,
          background 0.5s ease;
      }

      .split-bg-left {
        background: linear-gradient(
          135deg,
          rgba(10, 18, 38, 0.74) 0%,
          rgba(14, 24, 48, 0.65) 100%
        );
        backdrop-filter: blur(1.5px);
        -webkit-backdrop-filter: blur(1.5px);
      }

      .split-bg-right {
        background: linear-gradient(
          135deg,
          rgba(12, 14, 18, 0.74) 0%,
          rgba(18, 22, 28, 0.65) 100%
        );
        backdrop-filter: blur(1.5px);
        -webkit-backdrop-filter: blur(1.5px);
      }

      .split-side:hover .split-bg-left {
        background: linear-gradient(
          135deg,
          rgba(10, 22, 46, 0.58) 0%,
          rgba(16, 30, 60, 0.48) 100%
        );
      }

      .split-side:hover .split-bg-right {
        background: linear-gradient(
          135deg,
          rgba(12, 18, 14, 0.58) 0%,
          rgba(20, 30, 22, 0.48) 100%
        );
      }

      /* Noise texture overlay */
      .split-overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0.35;
        transition: opacity 0.5s ease;
      }

      .split-overlay-left {
        background:
          radial-gradient(
            ellipse at 20% 60%,
            rgba(99, 132, 255, 0.18),
            transparent 65%
          ),
          radial-gradient(
            ellipse at 80% 20%,
            rgba(60, 100, 220, 0.1),
            transparent 55%
          );
      }

      .split-overlay-right {
        background:
          radial-gradient(
            ellipse at 80% 60%,
            rgba(200, 255, 120, 0.1),
            transparent 65%
          ),
          radial-gradient(
            ellipse at 20% 20%,
            rgba(255, 220, 80, 0.07),
            transparent 55%
          );
      }

      .split-side:hover .split-overlay-left {
        opacity: 0.7;
      }

      .split-side:hover .split-overlay-right {
        opacity: 0.7;
      }

      /* Vertical divider line */
      #split-hero::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 0;
        bottom: 0;
        width: 1px;
        background: linear-gradient(
          to bottom,
          transparent,
          rgba(255, 255, 255, 0.15) 30%,
          rgba(255, 255, 255, 0.15) 70%,
          transparent
        );
        z-index: 5;
        pointer-events: none;
      }

      /* ---- Content ---- */

      .split-content {
        position: relative;
        z-index: 3;
        padding: 48px;
        transition:
          opacity 0.4s ease,
          transform 0.5s ease;
      }

      .split-content-left {
        padding-left: clamp(32px, 6vw, 96px);
        padding-right: 80px;
      }

      .split-content-right {
        padding-right: clamp(32px, 6vw, 96px);
        padding-left: 80px;
      }

      #split-hero:has(.split-right:hover) .split-content-left {
        opacity: 0.25;
        transform: translateX(-12px);
      }

      #split-hero:has(.split-left:hover) .split-content-right {
        opacity: 0.25;
        transform: translateX(12px);
      }

      .split-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 8px;
      }

      .split-title {
        font-size: clamp(2.8rem, 5vw, 5rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.03em;
        margin: 0 0 20px;
        color: var(--text);
        text-shadow: 0 4px 24px rgba(0, 0, 0, 0.95);
      }

      .split-right .split-title {
        color: hsl(80, 80%, 70%);
      }

      .split-left .split-title {
        color: hsl(220, 85%, 75%);
      }

      .split-desc {
        font-size: 1rem;
        color: #e4e4e7;
        max-width: 320px;
        line-height: 1.65;
        margin: 0 0 28px;
        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.95);
      }

      .split-traits {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .split-traits li {
        font-size: 0.9rem;
        color: #d4d4d8;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: color 0.25s ease;
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
      }

      .split-side:hover .split-traits li {
        color: #ffffff;
      }

      /* ---- Center Portrait ---- */

      .split-center {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        pointer-events: none;
      }

      .split-portrait-ring {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        padding: 3px;
        background: linear-gradient(
          135deg,
          hsl(220, 85%, 65%),
          hsl(80, 70%, 60%)
        );
        box-shadow:
          0 0 0 4px rgba(0, 0, 0, 0.6),
          0 20px 60px rgba(0, 0, 0, 0.8),
          0 0 50px rgba(255, 255, 255, 0.12);
        transition:
          transform 0.4s ease,
          box-shadow 0.4s ease;
      }

      #split-hero:has(.split-left:hover) .split-portrait-ring {
        box-shadow:
          0 0 0 4px hsl(220, 85%, 55%),
          0 20px 60px rgba(0, 0, 0, 0.6);
        transform: scale(1.08);
      }

      #split-hero:has(.split-right:hover) .split-portrait-ring {
        box-shadow:
          0 0 0 4px hsl(80, 70%, 55%),
          0 20px 60px rgba(0, 0, 0, 0.6);
        transform: scale(1.08);
      }

      .split-portrait {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        display: block;
      }

      .split-name-badge {
        background: rgba(0, 0, 0, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: 999px;
        padding: 6px 16px;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: #f4f4f5;
        text-transform: uppercase;
        white-space: nowrap;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.7);
      }

      /* =============================================
         PHILOSOPHY SECTION
      ============================================= */

      .personal-philosophy {
        padding: 120px 0;
        border-top: 1px solid var(--border);
      }

      .philosophy-inner {
        width: min(var(--max-width), calc(100% - 48px));
        margin-inline: auto;
      }

      .philosophy-inner h2 {
        font-size: clamp(2rem, 4vw, 3.5rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        margin: 0 0 20px;
        line-height: 1.1;
      }

      .section-description {
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.7;
        margin: 0 0 40px;
        max-width: 540px;
      }

      /* ---- Site CTA Link ---- */
      .site-link {
        display: inline-flex;
        margin-bottom: 48px;
        text-decoration: none;
        color: inherit;
      }

      .site-link-inner {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        padding: 16px 24px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(10px);
        transition:
          background 0.25s ease,
          border-color 0.25s ease,
          transform 0.25s ease,
          box-shadow 0.25s ease;
      }

      .site-link:hover .site-link-inner {
        background: rgba(255, 255, 255, 0.09);
        border-color: rgba(255, 255, 255, 0.28);
        transform: translateY(-2px);
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.06),
          0 12px 32px rgba(0, 0, 0, 0.4);
      }

      .site-link-icon {
        font-size: 1.5rem;
        line-height: 1;
        flex-shrink: 0;
      }

      .site-link-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .site-link-label {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .site-link-domain {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.01em;
      }

      .site-link-arrow {
        font-size: 1.3rem;
        color: var(--muted);
        transition:
          transform 0.25s ease,
          color 0.25s ease;
        margin-left: 4px;
      }

      .site-link:hover .site-link-arrow {
        transform: translate(3px, -3px);
        color: var(--text);
      }

      /* ---- Philosophy Cards (now clickable) ---- */
      .philosophy-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 48px;
      }

      .philosophy-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 32px 28px;
        display: flex;
        flex-direction: column;
        gap: 0;
        text-decoration: none;
        color: inherit;
        position: relative;
        overflow: hidden;
        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease,
          background 0.25s ease;
      }

      .philosophy-card-link {
        cursor: pointer;
      }

      .philosophy-card-link::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.04) 0%,
          transparent 60%
        );
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
      }

      .philosophy-card-link:hover {
        transform: translateY(-6px);
        border-color: rgba(255, 255, 255, 0.22);
        background: rgba(255, 255, 255, 0.04);
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.05),
          0 20px 48px rgba(0, 0, 0, 0.5);
      }

      .philosophy-card-link:hover::after {
        opacity: 1;
      }

      .philosophy-icon {
        font-size: 2rem;
        margin-bottom: 16px;
        line-height: 1;
      }

      .philosophy-card h3 {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0 0 12px;
        letter-spacing: -0.01em;
      }

      .philosophy-card p {
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.65;
        margin: 0 0 20px;
        flex: 1;
      }

      .card-cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
        margin-top: auto;
        transition:
          color 0.2s ease,
          gap 0.2s ease;
      }

      .card-cta-arrow {
        font-size: 1rem;
        font-weight: 400;
        transition: transform 0.2s ease;
        display: inline-block;
      }

      .philosophy-card-link:hover .card-cta {
        color: var(--text);
      }

      .philosophy-card-link:hover .card-cta-arrow {
        transform: translate(3px, -3px);
      }

      /* =============================================
         CURRENTLY SECTION
      ============================================= */

      .personal-currently {
        padding: 0 0 120px;
      }

      .currently-inner {
        width: min(var(--max-width), calc(100% - 48px));
        margin-inline: auto;
      }

      .currently-inner h2 {
        font-size: clamp(2rem, 4vw, 3.5rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        margin: 0 0 48px;
        line-height: 1.1;
      }

      .currently-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
      }

      .currently-item {
        display: flex;
        gap: 20px;
        align-items: flex-start;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 28px;
        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .currently-item:hover {
        transform: translateY(-4px);
        border-color: var(--border-hover);
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.03),
          0 16px 32px rgba(0, 0, 0, 0.3);
      }

      .currently-icon {
        font-size: 1.6rem;
        flex-shrink: 0;
        margin-top: 2px;
      }

      .currently-item h4 {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 6px;
      }

      .currently-item p {
        font-size: 0.95rem;
        color: var(--text);
        line-height: 1.6;
        margin: 0;
      }

      .story-link {
        color: var(--text);
        font-weight: 700;
        text-decoration: underline;
        text-decoration-color: rgba(255, 255, 255, 0.35);
        text-underline-offset: 4px;
        transition:
          color 0.2s ease,
          text-decoration-color 0.2s ease;
      }

      .story-link:hover,
      .story-link:focus-visible {
        color: #fff;
        text-decoration-color: #fff;
      }

      /* =============================================
         MOBILE RESPONSIVE
      ============================================= */

      @media (max-width: 768px) {
        #split-hero {
          flex-direction: column;
          height: auto;
          min-height: auto;
        }

        #split-hero::after {
          left: 0;
          right: 0;
          top: 50%;
          bottom: auto;
          width: auto;
          height: 1px;
          background: linear-gradient(
            to right,
            transparent,
            rgba(255, 255, 255, 0.15) 30%,
            rgba(255, 255, 255, 0.15) 70%,
            transparent
          );
        }

        .split-side {
          min-height: 50vh;
        }

        #split-hero:has(.split-left:hover) .split-left,
        #split-hero:has(.split-right:hover) .split-right {
          flex: 1;
        }

        #split-hero:has(.split-left:hover) .split-right,
        #split-hero:has(.split-right:hover) .split-left {
