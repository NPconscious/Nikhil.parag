---
import TasteLayout from "../layouts/TasteLayout.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
---

<TasteLayout
  title="Personal | Nikhil Parag"
  description="Stories, games, ideas and the things Nikhil Parag is exploring."
  themeColor="#141512"
>
  <header class="nav nav--centre">
    <div class="wrap nav__bar">
      <a class="skip-link" href="#top">Skip to content</a>
      <a class="nav__logo" href="/" aria-label="Nikhil Parag, homepage">
        <img src="/favicon.svg" alt="" width="24" height="24" />Nikhil Parag
      </a>
      <nav class="nav__links" aria-label="Personal page navigation">
        <div class="nav__item"><a class="nav__link" href="#interests">Interests</a></div>
        <div class="nav__item"><a class="nav__link" href="#stories">Manga and stories</a></div>
        <div class="nav__item"><a class="nav__link" href="#currently">Currently</a></div>
        <div class="nav__item"><a class="nav__link" href="/professional">Professional</a></div>
      </nav>
      <div class="nav__actions">
        <a class="btn btn--primary" href="mailto:nikhilparag0@gmail.com">Email Nikhil</a>
      </div>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Open navigation menu">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </div>
  </header>

  <main id="top" class="personal-page">
    <section class="hero hero--split personal-hero" data-enter aria-labelledby="personal-title">
      <div class="wrap">
        <div class="hero-text grid hero__grid">
          <div class="hero__text span-5">
            <p class="t-label">Away from the work</p>
            <h1 id="personal-title">Stories, games, and big questions</h1>
            <p class="hero__lead">I spend my free time in imagined worlds and exploring how our own works—from mythology and history to science, psychology and society.</p>
            <div class="btn-row">
              <a class="btn btn--primary" href="#interests">Explore my interests</a>
              <a class="btn btn--secondary" href="/professional#projects">View my work</a>
            </div>
          </div>
          <div class="hero__media span-6 start-7 personal-hero__media">
            <img src="/personal-hero-bg.jpg" alt="Snow-covered mountains reflected in a still alpine lake" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>

    <section class="section personal-interests" id="interests" aria-labelledby="interests-title">
      <div class="wrap">
        <div class="section-head">
          <p class="t-label">The things I follow</p>
          <h2 id="interests-title">Fiction and the real world</h2>
        </div>
        <div class="interest-grid">
          <article class="interest-block">
            <p class="interest-index">01 / FICTION</p>
            <h3>Worlds built from stories</h3>
            <p>Anime, manga, webtoons, manhwa, fantasy and science fiction. I enjoy the lore, characters and ideas that make a fictional world worth returning to.</p>
            <ul class="interest-tags" aria-label="Fiction interests">
              <li>Anime</li><li>Manga</li><li>Webtoons</li><li>Fantasy</li><li>RPGs</li><li>Tabletop games</li>
            </ul>
          </article>
          <article class="interest-block interest-block--seeker">
            <p class="interest-index">02 / CURIOSITY</p>
            <h3>How the world fits together</h3>
            <p>Space, artificial intelligence, history, geography, geopolitics, science, economics, psychology and the ideas behind society.</p>
            <ul class="interest-tags" aria-label="Topics I explore">
              <li>Space</li><li>AI</li><li>History</li><li>Science</li><li>Psychology</li><li>Society</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="section personal-stories" id="stories" aria-labelledby="stories-title">
      <div class="wrap">
        <div class="stories-heading">
          <div class="section-head">
            <p class="t-label">A project for readers</p>
            <h2 id="stories-title">Manga Anime Webtoon</h2>
          </div>
          <a class="btn btn--secondary" href="https://mangaanimewebtoon.com/" target="_blank" rel="noopener noreferrer">Visit the site</a>
        </div>
        <div class="story-grid">
          <a class="story-card" href="https://mangaanimewebtoon.com/reviews/" target="_blank" rel="noopener noreferrer">
            <span class="story-card__number">01</span><h3>Reviews</h3>
            <p>Thoughts on what is worth reading or watching, what is overhyped, and the hidden gems.</p>
            <span class="story-card__link">Read reviews <span aria-hidden="true">↗</span></span>
          </a>
          <a class="story-card" href="https://mangaanimewebtoon.com/news/" target="_blank" rel="noopener noreferrer">
            <span class="story-card__number">02</span><h3>News</h3>
            <p>Announcements, releases and updates from across anime, manga and webtoons.</p>
            <span class="story-card__link">Read the latest <span aria-hidden="true">↗</span></span>
          </a>
          <a class="story-card" href="https://mangaanimewebtoon.com/webnovel/" target="_blank" rel="noopener noreferrer">
            <span class="story-card__number">03</span><h3>Webnovels</h3>
            <p>Long-form fantasy, cultivation, isekai and system stories with room to build whole worlds.</p>
            <span class="story-card__link">Explore webnovels <span aria-hidden="true">↗</span></span>
          </a>
        </div>
      </div>
    </section>

    <section class="section personal-currently" id="currently" aria-labelledby="currently-title">
      <div class="wrap currently-layout">
        <div class="section-head">
          <p class="t-label">On the page right now</p>
          <h2 id="currently-title">Currently reading and writing</h2>
        </div>
        <div class="currently-list">
          <div class="currently-row">
            <p class="currently-label">Reading</p>
            <p>Lord of the Mysteries, Reverend Insanity, The Beginning After the End, Mother of Learning, and Shadow Slave.</p>
          </div>
          <div class="currently-row">
            <p class="currently-label">Writing</p>
            <p><a class="link" href="/the-second-young-master/">The Second Young Master</a></p>
          </div>
        </div>
      </div>
    </section>

    <footer class="footer personal-footer">
      <div class="wrap personal-footer__inner">
        <a class="nav__logo" href="/"><span class="mark" data-mark="arc" aria-hidden="true"></span>Nikhil Parag</a>
        <a class="link" href="/professional#projects">Back to the work portfolio <span aria-hidden="true">↗</span></a>
      </div>
    </footer>
  </main>

  <style is:global>
    html[data-type="service"] {
      color-scheme: dark;
      --p-bg: #141512;
      --p-surface: #20221e;
      --p-ink: #f1f0e9;
      --p-muted: #c0c1b8;
      --p-accent: #d1c44b;
      --p-accent-ink: #171811;
      --p-action: #d1c44b;
      --p-action-ink: #171811;
      --p-inv-bg: #20221e;
      --p-inv-surface: #292b26;
      --p-inv-ink: #f1f0e9;
      --p-inv-muted: #c0c1b8;
      --p-inv-accent: #d1c44b;
      --p-inv-accent-ink: #171811;
      --p-inv-action: #d1c44b;
      --p-inv-action-ink: #171811;
    }
    html[data-type="service"] body { color-scheme: dark; background: var(--p-bg); color: var(--p-ink); font-family: var(--font-text); }
    html[data-type="service"] body::before { display: none; }
    html[data-type="service"] main { width: 100%; max-width: none; margin: 0; overflow: visible; }
    html[data-type="service"] .personal-hero .hero__media > img { object-position: center 52%; }
    html[data-type="service"] .personal-hero .hero__text .t-label,
    html[data-type="service"] .personal-interests .section-head .t-label,
    html[data-type="service"] .personal-stories .section-head .t-label,
    html[data-type="service"] .personal-currently .section-head .t-label { margin: 0 0 var(--s-3); color: var(--p-muted); }
    html[data-type="service"] .personal-interests { background: var(--p-surface); }
    html[data-type="service"] .interest-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--gutter); }
    html[data-type="service"] .interest-block { min-width: 0; padding: clamp(24px,4vw,56px); background: var(--p-bg); }
    html[data-type="service"] .interest-index { margin: 0 0 var(--s-7); color: var(--p-muted); font-size: var(--t-small); letter-spacing: .08em; }
    html[data-type="service"] .interest-block h3 { margin: 0 0 var(--s-4); font: 400 clamp(26px,3vw,40px)/1.12 var(--font-display); letter-spacing: var(--display-tracking); }
    html[data-type="service"] .interest-block > p:not(.interest-index) { max-width: 48ch; color: var(--p-muted); line-height: 1.65; }
    html[data-type="service"] .interest-tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: var(--s-6) 0 0; }
    html[data-type="service"] .interest-tags li { padding: 7px 11px; border: 1px solid color-mix(in oklab,var(--p-ink) 20%,transparent); border-radius: 999px; font-size: var(--t-small); }
    html[data-type="service"] .stories-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--s-6); margin-bottom: var(--s-6); }
    html[data-type="service"] .stories-heading .section-head { margin: 0; }
    html[data-type="service"] .story-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    html[data-type="service"] .story-card { display: flex; flex-direction: column; min-height: 280px; padding: var(--s-6); color: var(--p-ink); text-decoration: none; border-right: 1px solid var(--line); transition: background .2s ease; }
    html[data-type="service"] .story-card:last-child { border-right: 0; }
    html[data-type="service"] .story-card:hover { background: var(--p-surface); }
    html[data-type="service"] .story-card__number { color: var(--p-muted); font-size: var(--t-small); }
    html[data-type="service"] .story-card h3 { margin: auto 0 var(--s-3); font: 400 clamp(26px,3vw,36px)/1.1 var(--font-display); letter-spacing: var(--display-tracking); }
    html[data-type="service"] .story-card p { max-width: 36ch; color: var(--p-muted); line-height: 1.55; }
    html[data-type="service"] .story-card__link { display: flex; justify-content: space-between; gap: 12px; margin-top: var(--s-5); font-size: var(--t-small); }
    html[data-type="service"] .personal-currently { background: var(--p-inv-bg); color: var(--p-inv-ink); }
    html[data-type="service"] .personal-currently .t-label { color: var(--p-inv-muted) !important; }
    html[data-type="service"] .currently-layout { display: grid; grid-template-columns: 5fr 7fr; gap: var(--gutter); }
    html[data-type="service"] .currently-layout .section-head { margin: 0; }
    html[data-type="service"] .currently-list { border-top: 1px solid color-mix(in oklab,var(--p-inv-ink) 24%,transparent); }
    html[data-type="service"] .currently-row { display: grid; grid-template-columns: 120px minmax(0,1fr); gap: var(--s-5); padding: var(--s-5) 0; border-bottom: 1px solid color-mix(in oklab,var(--p-inv-ink) 24%,transparent); }
    html[data-type="service"] .currently-row p { margin: 0; line-height: 1.6; }
    html[data-type="service"] .currently-label { color: var(--p-inv-muted); }
    html[data-type="service"] .personal-currently .link { color: var(--p-inv-ink); }
    html[data-type="service"] .personal-footer { padding-block: var(--s-5); }
    html[data-type="service"] .personal-footer__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    @media (max-width: 767px) {
      html[data-type="service"] .interest-grid,
      html[data-type="service"] .currently-layout { grid-template-columns: 1fr; }
      html[data-type="service"] .story-grid { grid-template-columns: 1fr; }
      html[data-type="service"] .story-card { min-height: 230px; border-right: 0; border-bottom: 1px solid var(--line); }
      html[data-type="service"] .story-card:last-child { border-bottom: 0; }
      html[data-type="service"] .stories-heading { align-items: start; flex-direction: column; }
      html[data-type="service"] .currently-row { grid-template-columns: 90px minmax(0,1fr); }
      html[data-type="service"] .personal-footer__inner { align-items: start; flex-direction: column; }
    }
  </style>
  <WhatsAppFloat />
</TasteLayout>
