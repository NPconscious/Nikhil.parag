---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Nikhil Parag"
  description="Founder of NPconscious - Information Science graduate with experience in international operations, customer success, and global sales."
>
  <!-- Mobile Navigation Toggle Button -->
  <button
    id="mobile-nav-toggle"
    class="mobile-nav-toggle"
    aria-label="Toggle navigation menu"
    aria-expanded="false"
  >
    <span id="mobile-toggle-icon" class="hamburger-icon">☰</span>
    <span id="mobile-toggle-text">Menu</span>
  </button>

  <!-- Mobile Navigation Backdrop -->
  <div id="nav-backdrop" class="nav-backdrop" aria-hidden="true"></div>

  <!-- Left Navigation Panel -->
  <aside id="left-panel" class="left-panel" aria-label="Main Navigation">
    <div class="panel-header">
      <a href="/#" class="panel-brand">
        <div class="avatar-ring">
          <img src="/profile.jpg" alt="Nikhil Parag" class="panel-avatar" />
          <span class="status-indicator" title="Open to opportunities"></span>
        </div>
        <div class="panel-brand-text">
          <span class="brand-name">Nikhil Parag</span>
          <span class="brand-title">Founder · NPconscious</span>
        </div>
      </a>
    </div>

    <nav class="panel-nav">
      <span class="panel-nav-heading">Navigation</span>
      <ul class="nav-list">
        <li>
          <a href="#mission" class="panel-link" data-section="mission">
            <span class="link-dot"></span>
            <span class="link-text">Mission</span>
          </a>
        </li>
        <li>
          <a href="#work" class="panel-link" data-section="work">
            <span class="link-dot"></span>
            <span class="link-text">Work</span>
          </a>
        </li>
        <li>
          <a href="#experience" class="panel-link" data-section="experience">
            <span class="link-dot"></span>
            <span class="link-text">Experience</span>
          </a>
        </li>
        <li>
          <a href="#education" class="panel-link" data-section="education">
            <span class="link-dot"></span>
            <span class="link-text">Education</span>
          </a>
        </li>
        <li>
          <a href="#contact" class="panel-link" data-section="contact">
            <span class="link-dot"></span>
            <span class="link-text">Contact</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="panel-footer">
      <a href="/personal" class="panel-personal-btn">
        <div class="personal-btn-content">
          <span class="personal-sparkle">✦</span>
          <div class="personal-btn-text">
            <span class="personal-btn-label">The Lorekeeper</span>
            <span class="personal-btn-sub">Manga, Gaming & Lore</span>
          </div>
        </div>
        <span class="personal-arrow">→</span>
      </a>

      <div class="panel-quick-contacts">
        <a
          href="https://wa.me/918088276492"
          target="_blank"
          rel="noopener noreferrer"
          title="WhatsApp"
          class="panel-contact-icon"
        >
          <img
            src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/whatsapp.svg"
            alt="WhatsApp"
          />
        </a>
        <a
          href="mailto:nikhilparag0@gmail.com"
          target="_blank"
          rel="noopener noreferrer"
          title="Email"
          class="panel-contact-icon"
        >
          <img
            src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/gmail.svg"
            alt="Email"
          />
        </a>
        <a
          href="https://www.instagram.com/nikhil_lord_of_edo/"
          target="_blank"
          rel="noopener noreferrer"
          title="Instagram"
          class="panel-contact-icon"
        >
          <img
            src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/instagram.svg"
            alt="Instagram"
          />
        </a>
      </div>
    </div>
  </aside>

  <main id="main">
    <section id="hero" class="hero">
      <img src="/profile.jpg" alt="Nikhil Parag" class="hero-image" />

      <h1>Nikhil Parag</h1>

      <p class="eyebrow">Founder of NPconscious</p>

      <p class="hero-description">
        Information Science graduate with experience in international
        operations, customer success, and global sales.
      </p>

      <div class="hero-actions">
        <a
          href="https://npconscious.com"
          target="_blank"
          class="btn btn-primary"
        >
          Explore NPconscious
        </a>

        <a href="#contact" class="btn btn-secondary"> Get In Touch </a>
      </div>
    </section>

    <section id="mission" class="section">
      <div class="content">
        <span class="section-label"> MISSION </span>

        <h2>What Drives Me</h2>

        <p>
          Education should create independent thinkers, not dependent learners.
        </p>

        <p>
          Through technology, mentorship and practical problem solving, I aim to
          create learning experiences that remain valuable long after the
          classroom ends.
        </p>
      </div>
    </section>

    <section id="work" class="section">
      <span class="section-label"> MY WORK </span>

      <h2>completed projects</h2>

      <div class="project-grid">
        <article class="project featured">
          <span> Research </span>

          <h3>
            <a
              href="https://www.ijcrt.org/author_details.php?name=Nikhil%20Parag&slot=3"
            >
              Signature Forgery Detection</a
            >
          </h3>

          <p>
            Published machine learning research using One-shot Learning to
            identify forged signatures in the International Journal of Creative
            Research Thoughts (ISSN: 2320-2882).
          </p>
        </article>

        <article class="project">
          <span> Edtech </span>

          <h3><a href="https://npconscious.com">NPconscious.com</a></h3>
          <div class="project-tags">
            <span class="tag">1-12 standard Mathematics </span>
            <span class="tag">No age limit</span>
            <span class="tag">Student first</span>
            <span class="tag">Engineering Mathematics</span>
          </div>
        </article>

        <article class="project">
          <span> Entertainment </span>

          <h3>
            <a href="https://mangaanimewebtoon.com">mangaanimewebtoon.com</a>
          </h3>
          <div class="project-tags">
            <span class="tag">Manga community</span>
            <span class="tag">Webtoon community</span>
            <span class="tag">Anime community</span>
          </div>
        </article>
      </div>
    </section>

    <!-- My Sales Journey — Visual Journey Map -->
    <section id="experience" class="journey-section">
      <div class="journey-inner">
        <span class="section-label">Work experience</span>
        <h2 class="journey-heading">My Career Journey</h2>
        <p class="journey-subheading">
          From Operations at Concentrix(Airbnb) to International Sales at
          Bhanzu(US & UK), then Study Abroad Counselling at USDC (Learn
          Overseas)
        </p>

        <!-- Metrics Strip -->
        <div class="journey-metrics-strip">
          <div class="jmetric">
            <span class="jmetric-num">5,000+</span>
            <span class="jmetric-lbl">Calls Handled Across Roles</span>
          </div>
          <div class="jmetric-divider" aria-hidden="true"></div>
          <div class="jmetric">
            <span class="jmetric-num">1,000+</span>
            <span class="jmetric-lbl">Operational Cases Resolved</span>
          </div>
          <div class="jmetric-divider" aria-hidden="true"></div>
          <div class="jmetric">
            <span class="jmetric-num">20+</span>
            <span class="jmetric-lbl">People Coordinated</span>
          </div>
          <div class="jmetric-divider" aria-hidden="true"></div>
          <div class="jmetric">
            <span class="jmetric-num">3</span>
            <span class="jmetric-lbl">International Roles</span>
          </div>
          <div class="jmetric-divider" aria-hidden="true"></div>
          <div class="jmetric">
            <span class="jmetric-num">1</span>
            <span class="jmetric-lbl">Published Research Paper</span>
          </div>
        </div>

        <!-- Journey Map -->
        <div class="journey-map">
          <!-- SVG Winding Path (desktop) -->
          <svg
            class="journey-path-svg"
            viewBox="0 0 1100 220"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <defs>
              <linearGradient id="pathGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop
                  offset="0%"
                  style="stop-color:hsl(200,90%,55%);stop-opacity:1"></stop>
                <stop
                  offset="50%"
                  style="stop-color:hsl(175,85%,45%);stop-opacity:1"></stop>
                <stop
                  offset="100%"
                  style="stop-color:hsl(45,90%,60%);stop-opacity:1"></stop>
              </linearGradient>
            </defs>
            <path
              class="journey-path-line"
              d="M 80 110 C 180 50, 280 170, 380 110 C 480 50, 580 170, 680 110 C 780 50, 880 170, 980 110 C 1020 90, 1060 95, 1100 110"
              fill="none"
              stroke="url(#pathGrad)"
              stroke-width="3"
              stroke-linecap="round"></path>
          </svg>

          <!-- Stop Nodes -->
          <div class="journey-stops">
            <div class="journey-stop" style="--stop-delay:0s">
              <div class="stop-node">
                <span class="stop-number">01</span>
              </div>
              <div class="stop-card">
                <span class="stop-category">Customer Operations</span>
                <h3 class="stop-title">Concentrix — Airbnb</h3>
                <p class="stop-desc">
                  Handled customer concerns and technical issues, learning to
                  stay calm and clear in challenging conversations. Built
                  patience, adaptability, and problem-solving under pressure.
                </p>
                <div class="stop-skills">
                  <span class="skill-tag">Patience</span>
                  <span class="skill-tag">Adaptability</span>
                  <span class="skill-tag">Problem-solving</span>
                </div>
              </div>
            </div>

            <div class="journey-stop stop-alt" style="--stop-delay:0.1s">
              <div class="stop-node">
                <span class="stop-number">02</span>
              </div>
              <div class="stop-card">
                <span class="stop-category">International EdTech Sales</span>
                <h3 class="stop-title">Bhanzu — US Market</h3>
                <p class="stop-desc">
                  Worked with international customers and parents, developing
                  practical experience in objection handling, understanding
                  prospect hesitation, and communicating value across cultures.
                </p>
                <div class="stop-skills">
                  <span class="skill-tag">Objection Handling</span>
                  <span class="skill-tag">Customer Psychology</span>
                  <span class="skill-tag">Value Communication</span>
                </div>
              </div>
            </div>

            <div class="journey-stop" style="--stop-delay:0.2s">
              <div class="stop-node">
                <span class="stop-number">03</span>
              </div>
              <div class="stop-card">
                <span class="stop-category">Study-Abroad Counselling</span>
                <h3 class="stop-title">USDC Global — Learn Overseas</h3>
                <p class="stop-desc">
                  Continued developing customer communication and counselling
                  skills in the study-abroad space, helping people navigate
                  important education decisions with clarity and confidence.
                </p>
                <div class="stop-skills">
                  <span class="skill-tag">Counselling</span>
                  <span class="skill-tag">Education Guidance</span>
                  <span class="skill-tag">Communication</span>
                </div>
              </div>
            </div>

            <div class="journey-stop stop-alt" style="--stop-delay:0.3s">
              <div class="stop-node">
                <span class="stop-number">04</span>
              </div>
              <div class="stop-card">
                <span class="stop-category">People Who Shaped the Journey</span>
                <h3 class="stop-title">Managers, Mentors & Founders</h3>
                <p class="stop-desc">
                  Learned from managers and mentors, and interacted with
                  founders whose perspectives helped me see how vision,
                  persistence, and execution turn ideas into something real.
                </p>
                <div class="stop-skills">
                  <span class="skill-tag">Leadership</span>
                  <span class="skill-tag">Vision</span>
                  <span class="skill-tag">Execution</span>
                </div>
              </div>
            </div>

            <div class="journey-stop" style="--stop-delay:0.4s">
              <div class="stop-node stop-node-gold">
                <span class="stop-number">05</span>
              </div>
              <div class="stop-card stop-card-gold">
                <span class="stop-category">Next Milestone</span>
                <h3 class="stop-title">Tech-Enabled Sales</h3>
                <p class="stop-desc">
                  My approach: listen first, understand the problem, build
                  trust, and create value. Combining human-centred sales with
                  technology to open new doors.
                </p>
                <div class="stop-skills">
                  <span class="skill-tag skill-tag-gold">Trust</span>
                  <span class="skill-tag skill-tag-gold">Value Creation</span>
                  <span class="skill-tag skill-tag-gold">Tech Sales</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <style>
        /* =============================================
           MY SALES JOURNEY SECTION
        ============================================= */

        .journey-section {
          padding: 120px 0;
          border-top: 1px solid var(--border);
          background:
            radial-gradient(
              ellipse at 10% 50%,
              hsla(210, 80%, 10%, 0.55),
              transparent 60%
            ),
            radial-gradient(
              ellipse at 90% 20%,
              hsla(175, 70%, 8%, 0.4),
              transparent 55%
            );
          position: relative;
          overflow: hidden;
        }

        .journey-inner {
          width: min(var(--max-width, 1100px), calc(100% - 48px));
          margin-inline: auto;
        }

        .journey-heading {
          font-size: clamp(2rem, 4vw, 3.2rem);
          font-weight: 800;
          letter-spacing: -0.03em;
          margin: 12px 0 16px;
          line-height: 1.1;
          background: linear-gradient(
            135deg,
            hsl(200, 90%, 75%) 0%,
            hsl(175, 80%, 65%) 50%,
            hsl(45, 85%, 65%) 100%
          );
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
        }

        .journey-subheading {
          color: var(--muted);
          font-size: 1.05rem;
          max-width: 520px;
          line-height: 1.7;
          margin: 0 0 40px;
        }

        /* Metrics Strip */
        .journey-metrics-strip {
          display: flex;
          align-items: center;
          flex-wrap: wrap;
          gap: 0;
          background: rgba(255, 255, 255, 0.03);
          border: 1px solid rgba(255, 255, 255, 0.08);
          border-radius: 16px;
          padding: 20px 32px;
          margin-bottom: 64px;
          backdrop-filter: blur(12px);
        }

        .jmetric {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 4px;
          flex: 1;
          min-width: 100px;
          padding: 8px 16px;
          text-align: center;
        }

        .jmetric-num {
          font-size: 1.75rem;
          font-weight: 800;
          letter-spacing: -0.04em;
          background: linear-gradient(
            135deg,
            hsl(200, 90%, 72%),
            hsl(175, 80%, 62%)
          );
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
          line-height: 1;
        }

        .jmetric-lbl {
          font-size: 0.72rem;
          color: var(--muted);
          font-weight: 500;
          letter-spacing: 0.05em;
          text-transform: uppercase;
          line-height: 1.35;
          max-width: 120px;
        }

        .jmetric-divider {
          width: 1px;
          height: 40px;
          background: rgba(255, 255, 255, 0.1);
          flex-shrink: 0;
          align-self: center;
        }

        @media (max-width: 700px) {
          .journey-metrics-strip {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            padding: 16px 14px;
            margin-bottom: 40px;
          }
          .jmetric-divider {
            display: none;
          }
          .jmetric {
            min-width: 0;
            padding: 10px 8px;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.05);
          }
          .jmetric:last-child {
            grid-column: 1 / -1;
          }
          .jmetric-num {
            font-size: 1.45rem;
          }
          .jmetric-lbl {
            font-size: 0.68rem;
            max-width: 160px;
          }
        }

        /* Journey Map Container */
        .journey-map {
          position: relative;
        }

        /* SVG Path */
        .journey-path-svg {
          display: block;
          width: 100%;
          height: 60px;
          margin-bottom: -20px;
          opacity: 0.55;
        }

        .journey-path-line {
          stroke-dasharray: 1600;
          stroke-dashoffset: 1600;
          animation: drawPath 2.2s ease forwards 0.3s;
        }

        @keyframes drawPath {
          to {
            stroke-dashoffset: 0;
          }
        }

        /* Stops Grid */
        .journey-stops {
          display: grid;
          grid-template-columns: repeat(5, 1fr);
          gap: 20px;
          position: relative;
        }

        .journey-stop {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 16px;
          opacity: 0;
          transform: translateY(20px);
          animation: fadeUpStop 0.55s ease forwards;
          animation-delay: var(--stop-delay, 0s);
        }

        @keyframes fadeUpStop {
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        /* Node circles */
        .stop-node {
          width: 52px;
          height: 52px;
          border-radius: 50%;
          background: linear-gradient(
            135deg,
            hsl(200, 85%, 20%),
            hsl(175, 75%, 18%)
          );
          border: 2px solid hsl(200, 80%, 45%);
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
          position: relative;
          z-index: 2;
          transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
          box-shadow: 0 0 0 4px rgba(56, 189, 220, 0.08);
        }

        .stop-node:hover,
        .journey-stop:hover .stop-node {
          transform: scale(1.12);
          box-shadow:
            0 0 0 6px rgba(56, 189, 220, 0.18),
            0 8px 24px rgba(0, 0, 0, 0.4);
        }

        .stop-node-gold {
          background: linear-gradient(
            135deg,
            hsl(45, 80%, 20%),
            hsl(38, 75%, 18%)
          );
          border-color: hsl(45, 85%, 55%);
          box-shadow: 0 0 0 4px rgba(240, 185, 60, 0.1);
        }

        .stop-node-gold:hover,
        .journey-stop:hover .stop-node-gold {
          box-shadow:
            0 0 0 6px rgba(240, 185, 60, 0.22),
            0 8px 24px rgba(0, 0, 0, 0.4);
        }

        .stop-number {
          font-size: 0.8rem;
          font-weight: 800;
          letter-spacing: 0.06em;
          color: hsl(200, 90%, 70%);
        }

        .stop-node-gold .stop-number {
          color: hsl(45, 90%, 68%);
        }

        /* Cards */
        .stop-card {
          background: rgba(255, 255, 255, 0.03);
          border: 1px solid rgba(255, 255, 255, 0.08);
          border-radius: 14px;
          padding: 22px 20px;
          width: 100%;
          transition:
            transform 0.28s ease,
            border-color 0.28s ease,
            box-shadow 0.28s ease,
            background 0.28s ease;
          backdrop-filter: blur(8px);
        }

        .stop-card:hover,
        .journey-stop:hover .stop-card {
          transform: translateY(-5px);
          border-color: rgba(56, 189, 220, 0.3);
          background: rgba(56, 189, 220, 0.05);
          box-shadow:
            0 12px 36px rgba(0, 0, 0, 0.35),
            0 0 0 1px rgba(56, 189, 220, 0.12);
        }

        .stop-card-gold:hover,
        .journey-stop:hover .stop-card-gold {
          border-color: rgba(240, 185, 60, 0.3);
          background: rgba(240, 185, 60, 0.05);
          box-shadow:
            0 12px 36px rgba(0, 0, 0, 0.35),
            0 0 0 1px rgba(240, 185, 60, 0.12);
        }

        .stop-category {
          display: block;
          font-size: 0.68rem;
          font-weight: 700;
          letter-spacing: 0.14em;
          text-transform: uppercase;
          color: hsl(200, 80%, 60%);
          margin-bottom: 8px;
        }

        .stop-card-gold .stop-category {
          color: hsl(45, 85%, 62%);
        }

        .stop-title {
          font-size: 0.95rem;
          font-weight: 700;
          margin: 0 0 10px;
          line-height: 1.3;
          color: var(--text);
          letter-spacing: -0.01em;
        }

        .stop-desc {
          font-size: 0.82rem;
          color: var(--muted);
          line-height: 1.65;
          margin: 0 0 14px;
        }

        /* Skill tags */
        .stop-skills {
          display: flex;
          flex-wrap: wrap;
          gap: 6px;
        }

        .skill-tag {
          font-size: 0.68rem;
          font-weight: 600;
          letter-spacing: 0.05em;
          padding: 3px 10px;
          border-radius: 999px;
          background: rgba(56, 189, 220, 0.1);
          border: 1px solid rgba(56, 189, 220, 0.2);
          color: hsl(200, 80%, 70%);
        }

        .skill-tag-gold {
          background: rgba(240, 185, 60, 0.1);
          border-color: rgba(240, 185, 60, 0.22);
          color: hsl(45, 85%, 68%);
        }

        /* =============================================
           RESPONSIVE — Mobile vertical route
        ============================================= */
        @media (max-width: 900px) {
          .journey-path-svg {
            display: none;
          }

          .journey-stops {
            grid-template-columns: 1fr;
            gap: 0;
            padding-left: 10px;
            position: relative;
          }

          .journey-stops::before {
            content: "";
            position: absolute;
            left: 17px;
            top: 18px;
            bottom: 18px;
            width: 2px;
            background: linear-gradient(
              to bottom,
              hsl(200, 80%, 50%),
              hsl(175, 75%, 45%),
              hsl(45, 80%, 55%)
            );
            opacity: 0.35;
          }

          .journey-stop {
            flex-direction: row;
            align-items: flex-start;
            gap: 12px;
            padding-bottom: 22px;
          }

          .stop-node {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            flex-shrink: 0;
            position: relative;
            z-index: 2;
          }

          .stop-number {
            font-size: 0.72rem;
          }

          .stop-card {
            flex: 1;
            min-width: 0;
            padding: 16px 14px;
          }

          .stop-title {
            font-size: 0.92rem;
            margin-bottom: 8px;
          }

          .stop-desc {
            font-size: 0.8rem;
            line-height: 1.55;
            margin-bottom: 10px;
          }

          .skill-tag {
            font-size: 0.65rem;
            padding: 2px 8px;
          }

          .journey-metric {
            flex-direction: column;
            align-items: flex-start;
            gap: 6px;
          }

          .metric-label {
            max-width: 240px;
          }
        }

        @media (max-width: 600px) {
          .journey-section {
            padding: 80px 0;
          }
          .journey-metric {
            margin-bottom: 44px;
          }
        }

        /* Respect reduced motion */
        @media (prefers-reduced-motion: reduce) {
          .journey-path-line {
            animation: none;
            stroke-dashoffset: 0;
          }
          .journey-stop {
            animation: none;
            opacity: 1;
            transform: none;
          }
        }
      </style>
    </section>

    <section id="education" class="section">
      <span class="section-label"> EDUCATION </span>

